# 必填：Google Gemini API Key (可於 https://aistudio.google.com/app/apikey 免費申請)
GEMINI_API_KEY=your_gemini_api_key_here

# 選填（免費正版 API 最後備選通道）：Microsoft Azure Speech 官方免費 F0 金鑰 (每月 50 萬字免費，具 100% 商用與公開發布授權)
# 申請方式：於 https://portal.azure.com 建立「語音服務 (Speech)」，定價層選「Free F0」即可取得 Key 與 Region
# AZURE_SPEECH_KEY=your_azure_speech_key_here
# AZURE_SPEECH_REGION=eastasia

# 選填：覆蓋 config.yaml 中的 GitHub Pages 網址
# PODCAST_BASE_URL=https://your-username.github.io/daily-bilingual-podcast

# 選填：覆蓋 config.yaml 中的聯絡信箱 (供 Apple Podcasts / Spotify 驗證使用)
# PODCAST_EMAIL=your-email@example.com
